# This file documents every environment/config value the project needs.
# It is a reference only — the values that actually get read at runtime live in:
#   backend/SchoolMS.Api/appsettings.Development.json   (backend, real local dev values)
#   frontend/.env.local                                  (frontend, copy from frontend/.env.local.example)
# Neither of those files contains a real production secret — see README.md "Assumptions".

# ---------- Backend (ASP.NET Core / appsettings.Development.json) ----------

# PostgreSQL connection string. Update Username/Password/Database to match your local Postgres.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=schoolms;Username=postgres;Password=CHANGE_ME

# JWT signing configuration. Key must be a long random string in any real deployment.
Jwt__Key=CHANGE_ME_REPLACE_WITH_A_REAL_SECRET_KEY
Jwt__Issuer=SchoolMS
Jwt__Audience=SchoolMSClient
Jwt__ExpiryMinutes=60

# ---------- Frontend (Next.js / frontend/.env.local) ----------

# Base URL of the running backend API (must match the port ASP.NET Core is listening on).
NEXT_PUBLIC_API_URL=http://localhost:5047/api
